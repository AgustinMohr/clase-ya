# Copiá este archivo a `.env` (no se versiona) y completá el client id.
#
# Debe ser el MISMO client id que usa el backend en GOOGLE_CLIENT_ID.
# En Google Cloud Console: Credentials → OAuth client ID → tipo "Web application".
# Authorized JavaScript origins debe incluir: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# El backend se alcanza por el proxy de Vite (/api -> http://localhost:8080); no hace falta URL de API.
